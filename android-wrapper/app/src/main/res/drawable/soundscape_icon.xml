<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/soundscape_background" />

    <item
        android:width="76dp"
        android:height="76dp"
        android:gravity="center">
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <gradient
                android:angle="315"
                android:endColor="#D98A55"
                android:startColor="#2E6368" />
        </shape>
    </item>

    <item
        android:width="34dp"
        android:height="34dp"
        android:gravity="center">
        <shape android:shape="oval">
            <solid android:color="#FFF7EF" />
        </shape>
    </item>
</layer-list>